# Copy this file to `.env` (same directory) and fill in your real values.
# .env is gitignored, so your keys stay local.
#
# You only need to set the keys for the models you want to use.
# The UI will only show providers whose key is present.

# ---------- Anthropic (Claude) ----------
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6   # or claude-opus-4-7 / claude-haiku-4-5

# ---------- OpenAI (GPT) ----------
# Get a key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1   # override if you use a proxy

# ---------- MiniMax ----------
# Docs: https://platform.minimaxi.com/ or https://api.minimax.chat/
# MINIMAX_API_KEY=...
# MINIMAX_MODEL=MiniMax-Text-01
# MINIMAX_BASE_URL=https://api.minimax.chat/v1   # 中国大陆。海外可用 https://api.minimaxi.com/v1

# ---------- DeepSeek ----------
# Docs: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat                   # or deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- Server ----------
# PORT=3001
